# Mobil1 POSM Tracker — Environment Variables
# Copy file ini ke `.env.local` dan isi credentials Anda.
# `.env.local` SUDAH di-gitignore. Variabel client wajib pakai prefix VITE_.

# === Supabase (Step 1 di README) ===
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJI...

# === Cloudflare CDN URL untuk akses foto ===
VITE_CDN_BASE_URL=https://cdn.your-domain.com

# ============================================================
# CATATAN: B2 credentials JANGAN ditaruh di sini.
# Itu disimpan di Supabase Edge Function secrets via CLI:
#
#   supabase secrets set B2_KEY_ID=...
#   supabase secrets set B2_APPLICATION_KEY=...
#   supabase secrets set B2_BUCKET_NAME=...
#   supabase secrets set B2_ENDPOINT=...
#   supabase secrets set B2_REGION=...
#   supabase secrets set CDN_BASE_URL=...
#
# Lihat README Step 4 untuk detail.
# ============================================================
